# ZeroPrep runs fully locally by default: local Whisper for speech, a local LLM
# for presentation direction, and local ComfyUI for scene imagery. No keys are
# needed. See LOCAL_SETUP.md.

# Optional: point the local stack at other ports, hosts, or models.
# ZEROPREP_LOCAL=1
# ZEROPREP_DIRECTOR_URL=http://127.0.0.1:1234/v1
# ZEROPREP_DIRECTOR_MODEL=zeroprep-director
# ZEROPREP_ASR_URL=http://127.0.0.1:8099
# ZEROPREP_ASR_MODEL=large-v3
# ZEROPREP_COMFY_URL=http://127.0.0.1:8188
# ZEROPREP_COMFY_CHECKPOINT=juggernautXL_v8Rundiffusion.safetensors
# ZEROPREP_COMFY_DIR=/path/to/ComfyUI

# Cloud fallback (only used when ZEROPREP_LOCAL=0, or ZEROPREP_LOCAL_IMAGERY=0
# for imagery alone).
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_google_ai_studio_api_key
